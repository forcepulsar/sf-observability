# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT  →  copy to .env.dev (gitignored)
# =============================================================================
# .env.dev and .env.prod are IDENTICAL except for the ClickHouse database name.
# Dev points at the empty `salesforceDev` database; prod points at `salesforceProd`.
# Bootstrap the dev database once with:
#     ./schema/setup.sh <host> <password> salesforceDev
# Then populate it via the ingest backfill (--backfill). No prod data is copied.
#
# To run ingest against dev, load this file, e.g.:
#     docker compose --env-file .env.dev run --rm ingest /app/ingest.py --backfill
# -----------------------------------------------------------------------------
# Everything below is a PLACEHOLDER — fill in real values in your local .env.dev.
# The credentials/host are the SAME as prod; only the *_DATABASE lines differ.

# ── Salesforce auth (same as prod) ───────────────────────────────────────────
SF_JWT_CLIENT_ID=
SF_JWT_KEY_FILE=/app/cert/server.key
SF_JWT_USERNAME=your-sf-user@yourorg.com
SF_INSTANCE_URL=https://yourorg.my.salesforce.com
SF_ORG_ALIAS=MyOrg
SF_ACCESS_TOKEN=

# ── ClickHouse — ingest container (same host/creds as prod) ──────────────────
CH_HOST=https://abc123.us-east-1.aws.clickhouse.cloud
CH_PORT=8443
CH_USER=default
CH_PASSWORD=yourpassword
CH_DATABASE=salesforceDev          # ← the ONLY difference from prod

# ── ClickHouse — Grafana datasource + LibreChat MCP (same host/creds) ────────
CLICKHOUSE_HOST=abc123.us-east-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=yourpassword
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=salesforceDev  # ← the ONLY difference from prod

# ── LibreChat / Grafana / Postgres (same as prod) ────────────────────────────
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-32
CREDS_KEY=generate-with-openssl-rand-hex-32
CREDS_IV=generate-with-openssl-rand-hex-16
MEILI_MASTER_KEY=generate-with-openssl-rand-hex-32
ANTHROPIC_API_KEY=sk-ant-api03-...
ALLOW_EMAIL_LOGIN=true
DEBUG_LOGGING=false
NO_INDEX=true
UID=1000
GID=1000
GRAFANA_PORT=3000
LIBRECHAT_PORT=3080
GRAFANA_ADMIN_PASSWORD=change-me-on-first-login
POSTGRES_DB=librechat_rag
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-16
