{
  "uid": "sf-ingest-health",
  "title": "Ingestion Pipeline Health",
  "tags": [
    "ingestion",
    "ops"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 38,
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "## How this works\nThe pipeline runs **every 2 hours**. It has two steps: **\u2460 Event Logs** (pulls login, API, Apex, etc. from Salesforce \u2014 takes ~30 min) then **\u2461 Threats & Audit** (pulls Shield detections and config changes \u2014 takes ~1 min). Between runs it sleeps. If the laptop sleeps/reboots, the sleep gets stuck and the pipeline won't run again until restarted."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pipeline Status",
      "description": "Green = sleeping normally. Yellow = overdue (sleep may be stuck). Red = hasn't run in 24h+.",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "cfgz0zrjwhudcc"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value",
        "orientation": "auto",
        "text": {
          "valueSize": 28
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": -9999,
                "to": 0,
                "result": {
                  "text": "RUNNING NOW",
                  "color": "blue",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 180,
                "result": {
                  "text": "SLEEPING OK",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 180,
                "to": 300,
                "result": {
                  "text": "OVERDUE",
                  "color": "yellow",
                  "index": 2
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 300,
                "to": 9999999,
                "result": {
                  "text": "STUCK \u2014 RESTART",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cfgz0zrjwhudcc"
          },
          "rawSql": "SELECT dateDiff('minute', max(ended_at), now()) AS minutes_since_last_run FROM ingestion_runs WHERE script = 'ingest' AND status IN ('success','partial')",
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Next Run",
      "description": "When the next ingest cycle is expected to start. If this shows 'ago', the pipeline is stuck.",
      "gridPos": {
        "x": 5,
        "y": 2,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "cfgz0zrjwhudcc"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1700000000000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cfgz0zrjwhudcc"
          },
          "rawSql": "SELECT toUnixTimestamp(addSeconds(max(ended_at), 7200)) * 1000 AS next_run FROM ingestion_runs WHERE script = 'ingest' AND status IN ('success','partial')",
          "format": "table"
        }
      ]
    },
