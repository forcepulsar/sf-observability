            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 12
                    },
                    {
                      "color": "red",
                      "value": 26
                    }
                  ]
                }
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cfgz0zrjwhudcc"
          },
          "rawSql": "SELECT event_type, max(log_date) AS latest_log_date, argMax(interval, ingested_at) AS interval, count() AS total_files, sum(row_count) AS total_rows, max(ingested_at) AS last_ingested_at, round(dateDiff('minute', max(ingested_at), now()) / 60.0, 1) AS hours_since_ingested FROM salesforceProd.ingestion_state FINAL GROUP BY event_type ORDER BY hours_since_ingested ASC",
          "format": "table"
        }
      ]
    },
