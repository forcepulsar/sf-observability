    {
      "id": 13,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "## Ingested Log Files\nShows the most-recent ingested file per event type \u2014 equivalent to browsing the Salesforce Event Log File Browser. `log_date` is the date/hour the Salesforce log covers (not when it was ingested). Use this to spot gaps: if an event type is missing from the last 24 h of expected log files, the pipeline may have skipped it."
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Ingested Log Files \u2014 Latest per Event Type",
      "description": "One row per (event_type, log_date) pair. Shows every SF log file slot tracked in ingestion_state, newest first. interval = Hourly or Daily.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "cfgz0zrjwhudcc"
      },
      "options": {
        "sortBy": [
          {
            "displayName": "log_date",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "interval"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Hourly": {
                        "text": "Hourly",
                        "color": "blue",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "Daily": {
                        "text": "Daily",
                        "color": "purple",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hours_since_ingested"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 12
                    },
                    {
                      "color": "red",
                      "value": 26
                    }
                  ]
                }
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cfgz0zrjwhudcc"
          },
          "rawSql": "SELECT event_type, argMax(interval, ingested_at) AS interval, log_date, argMax(log_file_id, ingested_at) AS latest_log_file_id, argMax(row_count, ingested_at) AS row_count, max(ingested_at) AS last_ingested_at, round(dateDiff('minute', max(ingested_at), now()) / 60.0, 1) AS hours_since_ingested FROM salesforceProd.ingestion_state FINAL GROUP BY event_type, log_date ORDER BY log_date DESC, event_type ASC LIMIT 200",
          "format": "table"
        }
      ]
    },
    {
      "id": 15,
      "type": "table",
      "title": "Latest Ingested File per Event Type (Summary)",
      "description": "One row per event type \u2014 shows the most recent log file ingested and how long ago. Red = stale (>26h), yellow = overdue (>12h), green = current.",
