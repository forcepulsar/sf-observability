# =============================================================================
# SALESFORCE AUTHENTICATION
# =============================================================================
# JWT/ECA is the only supported auth method for production (unattended Docker).
# See README.md → "Salesforce Setup" for the one-time ECA + certificate setup.
#
# Required variables:
SF_JWT_CLIENT_ID=                         # Consumer Key from your External Client App
SF_JWT_KEY_FILE=/app/cert/server.key      # In-container path — place server.key in ./cert/
SF_JWT_USERNAME=your-sf-user@yourorg.com  # Salesforce username the ingest runs as
SF_INSTANCE_URL=https://yourorg.my.salesforce.com

# Org alias used by the SF CLI JWT login command.
SF_ORG_ALIAS=MyOrg

# CI/CD only — if your pipeline pre-obtains a token (e.g. via a JWT step),
# you can pass it here instead of setting up the full SF CLI JWT flow.
# Leave blank for normal Docker deployments.
SF_ACCESS_TOKEN=

# Optional: write ingest logs to a file in addition to stdout.
# LOG_FILE=/app/logs/ingest.log

# =============================================================================
# CLICKHOUSE CLOUD — FILL IN BOTH BLOCKS (they must match)
# =============================================================================
# ⚠️  Two blocks are required:
#    CH_*         → used by the ingest container (includes https://)
#    CLICKHOUSE_* → used by Grafana and LibreChat MCP (no https://, no port)
#    Both must point to the same cluster with the same credentials.

# Block 1 — ingest scripts
CH_HOST=https://abc123.us-east-1.aws.clickhouse.cloud
CH_PORT=8443
CH_USER=default
CH_PASSWORD=yourpassword
CH_DATABASE=salesforceProd

# Block 2 — Grafana datasource + LibreChat MCP (same values, different format)
CLICKHOUSE_HOST=abc123.us-east-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=yourpassword
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=salesforceProd

# =============================================================================
# LIBRECHAT — generate once with: openssl rand -hex 32
# =============================================================================
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-32
CREDS_KEY=generate-with-openssl-rand-hex-32
CREDS_IV=generate-with-openssl-rand-hex-16
MEILI_MASTER_KEY=generate-with-openssl-rand-hex-32
ANTHROPIC_API_KEY=sk-ant-api03-...

ALLOW_EMAIL_LOGIN=true
DEBUG_LOGGING=false
NO_INDEX=true
UID=1000
GID=1000

# Session length. Leave these set — LibreChat's built-in default access token is
# only 15 minutes, which bounces analysts back to the login screen whenever they
# read query results for more than ~15 min between questions. 12h keeps a login
# valid for a full workday; the 30d refresh window renews it silently in between.
SESSION_EXPIRY=1000 * 60 * 60 * 12
REFRESH_TOKEN_EXPIRY=1000 * 60 * 60 * 24 * 30

# =============================================================================
# PORTS — change if defaults conflict with other services on this machine
# =============================================================================
GRAFANA_PORT=3000
LIBRECHAT_PORT=3080

# =============================================================================
# GRAFANA
# =============================================================================
GRAFANA_ADMIN_PASSWORD=change-me-on-first-login

# =============================================================================
# POSTGRES (LibreChat RAG vector store — internal Docker network only)
# =============================================================================
POSTGRES_DB=librechat_rag
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-16
